class_name Culture
extends RefCounted
## The shop's biggest shelf: knights and bamboo, tea and tacos, folk tales and street food, from all over the planet. Cosmetics
## adds these to its lists, and they work like everything else in it. As with the rest of the world collection, sacred dress
## and ceremonial objects stay out: this is all stories, festivals, kitchens and playgrounds.

static func list(slot: String) -> Array:
	match slot:
		"char": return HEROES
		"face": return FACES
		"hat": return HATS
		"mask": return MASKS
		"top": return TOPS
		"pants": return PANTS
		"shoes": return SHOES
		"gloves": return GLOVES
		"back": return BACKS
		"pet": return PETS
		"run": return RUNS
		"dance": return DANCES
		"emote": return EMOTES
		"frame": return FRAMES
		"title": return TITLES
		"skin": return SKINS
		"trail": return TRAILS
		"aura": return AURAS
		"burst": return BURSTS
	return []



